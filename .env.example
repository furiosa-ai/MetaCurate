# LLM credentials. Do NOT commit real values. Leave everything empty to run
# the offline demo with the deterministic mock client.

# The four run cells route every role through OpenRouter; the launcher
# (scripts/run_metadata_free.py) reads this key from ~/.env.
OPENROUTER_API_KEY=

# Direct OpenAI-compatible or Anthropic access, for `meta_filter.cli run`
# with --llm-provider openai / anthropic.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# How the claude-code provider authenticates: oauth (default) or api_key.
META_FILTER_CLAUDE_AUTH=
